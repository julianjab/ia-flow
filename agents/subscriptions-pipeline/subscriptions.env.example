# Copiar a `.env` en ESTA carpeta (gitignoreado — la regla ".env" en la raíz
# del repo cubre cualquier profundidad) — lo usa docker-compose.yml para el
# servicio `subscriptions`. Ver README.md acá al lado.

# Token OAuth de Claude Code (no la API key) — buildAnthropicAuthHeader
# (packages/ai-providers/src/anthropic-api/auth.ts) lo prioriza sobre
# ANTHROPIC_API_KEY cuando ambos están seteados. Obtenelo corriendo
# `claude setup-token` con el CLI de Claude Code, o desde donde tu cuenta
# ya lo tenga generado.
CLAUDE_CODE_OAUTH_TOKEN=

# GITHUB_TOKEN necesita permisos de escritura sobre la-haus/subscriptions:
# contents (crear branch + comitear archivos), pull_requests (abrir/leer PR
# + checks), e issues (leer/mover status vía label + comentar el link del
# PR). Lo usa tanto el source github-issues (leer/mover el issue) como el
# MCP de GitHub (escribir el código, revisar CI) — mismo token para los tres
# agentes.
GITHUB_TOKEN=ghp_...

# Opcional: si lo dejás vacío, entrypoint.sh genera uno solo al primer boot
# y lo persiste en /data/webhook-secret (sobrevive a restarts del contenedor).
# Ver README.md, sección "URL del túnel + secret del webhook".
IA_FLOW_WEBHOOK_SECRET=

# Nivel de log (Pino, apps/server/src/logger.ts) — trace/debug/info/warn/error/fatal.
# Dejar vacío = info. Subilo a debug para ver el detalle de por qué un scan
# incluye o descarta un issue puntual.
LOG_LEVEL=

# Log forwarding del pipeline hacia el server principal que corre en el
# host (bun run start / bun run dev:server, puerto 3001) — así ves los logs
# de este container en el mismo daemon.log/UI que ya usás. El server
# principal necesita el MISMO valor de IA_FLOW_REMOTE_LOG_TOKEN en su propio
# entorno (ej. `IA_FLOW_REMOTE_LOG_TOKEN=... bun run start`), o rechaza todo
# con 503. Dejar las dos vacías para desactivar el forward (sigue logueando
# normal a su propio /data/logs, nada más).
IA_FLOW_REMOTE_LOG_URL=http://host.docker.internal:3001/api/remote-logs
IA_FLOW_REMOTE_LOG_TOKEN=
