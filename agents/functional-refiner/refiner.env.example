# Copiar a `.env` en ESTA carpeta (gitignoreado — la regla ".env" en la raíz
# del repo cubre cualquier profundidad) — lo usa docker-compose.yml para el
# servicio `refiner`. Ver README.md acá al lado.

ANTHROPIC_API_KEY=sk-ant-...
GITHUB_TOKEN=ghp_...
IA_FLOW_WEBHOOK_SECRET=algo-random

# Log forwarding del refiner hacia el server principal que corre en el host
# (bun run dev:server, puerto 3001) — ver ../../apps/server/src/logger.ts /
# ../../apps/server/src/routes/remote-logs.ts. El server principal necesita
# el MISMO valor de IA_FLOW_REMOTE_LOG_TOKEN en su propio entorno, o rechaza
# todo con 503.
#
# Dejar IA_FLOW_REMOTE_LOG_TOKEN vacío para desactivar el forward (el
# refiner sigue logueando normal a su propio /data/logs, solo no reenvía).
IA_FLOW_REMOTE_LOG_TOKEN=
