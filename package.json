{
  "name": "ia-flow",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/agent-engine/*",
    "packages/agent-engine/datasources/*",
    "packages/github/*",
    "packages/local/*",
    "packages/providers/*",
    "packages/providers/anthropic/*",
    "packages/slack/*"
  ],
  "scripts": {
    "dev": "bun run dev:web",
    "dev:web": "bun run --cwd apps/web dev",
    "start:web": "bun run --cwd apps/web build && bun run --cwd apps/web preview",
    "runner": "bun run --cwd apps/runner-v2 start",
    "runner:serve": "bun run --cwd apps/runner-v2 serve",
    "runner:host": "bun run --cwd apps/runner-v2 host:serve",
    "release:package": "bun run scripts/package-release.ts",
    "build": "bun run --cwd packages/shared build && bun run --cwd apps/web build",
    "install:all": "bun install",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "lint:boundaries": "depcruise apps/runner-v2 packages --config .dependency-cruiser.cjs",
    "format": "biome format --write .",
    "biome": "biome check --write .",
    "typecheck:shared": "bun run --cwd packages/shared typecheck",
    "test:shared": "bun run --cwd packages/shared test",
    "typecheck:rules": "bun run --cwd packages/rules typecheck",
    "test:rules": "bun run --cwd packages/rules test",
    "typecheck:agent-engine": "bun run --cwd packages/agent-engine/core typecheck",
    "test:agent-engine": "bun run --cwd packages/agent-engine/core test",
    "typecheck:agent-engine-definitions": "bun run --cwd packages/agent-engine/definitions typecheck",
    "test:agent-engine-definitions": "bun run --cwd packages/agent-engine/definitions test",
    "typecheck:datasource-sqlite": "bun run --cwd packages/agent-engine/datasources/sqlite typecheck",
    "test:datasource-sqlite": "bun run --cwd packages/agent-engine/datasources/sqlite test",
    "typecheck:datasource-yaml": "bun run --cwd packages/agent-engine/datasources/yaml typecheck",
    "test:datasource-yaml": "bun run --cwd packages/agent-engine/datasources/yaml test",
    "typecheck:provider-anthropic-api": "bun run --cwd packages/providers/anthropic/api typecheck",
    "test:provider-anthropic-api": "bun run --cwd packages/providers/anthropic/api test",
    "typecheck:provider-anthropic-cli": "bun run --cwd packages/providers/anthropic/cli typecheck",
    "test:provider-anthropic-cli": "bun run --cwd packages/providers/anthropic/cli test",
    "typecheck:provider-shared": "bun run --cwd packages/providers/shared typecheck",
    "test:provider-shared": "bun run --cwd packages/providers/shared test",
    "typecheck:provider-remote": "bun run --cwd packages/providers/remote typecheck",
    "test:provider-remote": "bun run --cwd packages/providers/remote test",
    "typecheck:telemetry": "bun run --cwd packages/telemetry typecheck",
    "test:telemetry": "bun run --cwd packages/telemetry test",
    "typecheck:github-auth": "bun run --cwd packages/github/auth typecheck",
    "test:github-auth": "bun run --cwd packages/github/auth test",
    "typecheck:github-api": "bun run --cwd packages/github/api typecheck",
    "test:github-api": "bun run --cwd packages/github/api test",
    "typecheck:github-webhook": "bun run --cwd packages/github/webhook typecheck",
    "test:github-webhook": "bun run --cwd packages/github/webhook test",
    "typecheck:github-tools": "bun run --cwd packages/github/tools typecheck",
    "test:github-tools": "bun run --cwd packages/github/tools test",
    "typecheck:slack-api": "bun run --cwd packages/slack/api typecheck",
    "test:slack-api": "bun run --cwd packages/slack/api test",
    "typecheck:slack-tools": "bun run --cwd packages/slack/tools typecheck",
    "test:slack-tools": "bun run --cwd packages/slack/tools test",
    "typecheck:slack-socket": "bun run --cwd packages/slack/socket typecheck",
    "test:slack-socket": "bun run --cwd packages/slack/socket test",
    "typecheck:fs": "bun run --cwd packages/local/fs typecheck",
    "test:fs": "bun run --cwd packages/local/fs test",
    "typecheck:shell": "bun run --cwd packages/local/shell typecheck",
    "test:shell": "bun run --cwd packages/local/shell test",
    "typecheck:workspace": "bun run --cwd packages/local/workspace typecheck",
    "test:workspace": "bun run --cwd packages/local/workspace test",
    "typecheck:runner-v2": "bun run --cwd apps/runner-v2 typecheck",
    "test:runner-v2": "bun run --cwd apps/runner-v2 test",
    "typecheck:web": "bun run --cwd apps/web typecheck",
    "test:web": "bun run --cwd apps/web test",
    "typecheck:desktop": "bun run --cwd apps/desktop typecheck",
    "test:desktop": "bun test apps/desktop",
    "typecheck": "bun run typecheck:shared && bun run typecheck:rules && bun run typecheck:agent-engine && bun run typecheck:agent-engine-definitions && bun run typecheck:datasource-sqlite && bun run typecheck:datasource-yaml && bun run typecheck:provider-shared && bun run typecheck:provider-anthropic-api && bun run typecheck:provider-anthropic-cli && bun run typecheck:provider-remote && bun run typecheck:telemetry && bun run typecheck:github-auth && bun run typecheck:github-api && bun run typecheck:github-webhook && bun run typecheck:github-tools && bun run typecheck:slack-api && bun run typecheck:slack-tools && bun run typecheck:slack-socket && bun run typecheck:fs && bun run typecheck:shell && bun run typecheck:workspace && bun run typecheck:runner-v2 && bun run typecheck:web && bun run typecheck:desktop",
    "test": "bun run test:shared && bun run test:rules && bun run test:agent-engine && bun run test:agent-engine-definitions && bun run test:datasource-sqlite && bun run test:datasource-yaml && bun run test:provider-shared && bun run test:provider-anthropic-api && bun run test:provider-anthropic-cli && bun run test:provider-remote && bun run test:telemetry && bun run test:github-auth && bun run test:github-api && bun run test:github-webhook && bun run test:github-tools && bun run test:slack-api && bun run test:slack-tools && bun run test:slack-socket && bun run test:fs && bun run test:shell && bun run test:workspace && bun run test:runner-v2 && bun run test:web && bun run test:desktop",
    "check": "biome check . && bun run plugin:check && bun run lint:boundaries && bun run typecheck && bun run test",
    "plugin:sync": "bun run scripts/sync-plugin-docs.ts",
    "plugin:check": "bun run scripts/sync-plugin-docs.ts --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "dependency-cruiser": "^18.5.0"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild",
    "vue-demi"
  ]
}
