node_modules/
dist/
.env
.env.host
*.local
.DS_Store
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.playwright-mcp/
.clone/
# npm lockfiles are forbidden — bun is the only package manager
apps/**/package-lock.json
packages/**/package-lock.json

# El agent-host.yaml real describe UNA máquina (nombre, URL, paths) — lo que
# se commitea es `agent-host.example.yaml`. `agent-host.backend.yaml` es un
# segundo proceso (otro toolchain, otra máquina lógica) con la misma regla.
apps/agent-host/agent-host.yaml
apps/agent-host/agent-host.backend.yaml

# runner-v2: la config para correrlo en local es de cada quien (la de un deploy vive en su repo,
# p. ej. claw-agents), y el estado va a IA_FLOW_HOME. `.state/` queda por los checkouts viejos.
apps/runner-v2/.config/
apps/runner-v2/.state/

# El lockfile binario de Bun < 1.2: el que se versiona es `bun.lock` (texto).
bun.lockb

# El workspace de un editor es de cada quien.
*.code-workspace

# Credenciales: la llave privada de la GitHub App (y cualquier otra) nunca va al repo.
*.pem
