# Copiar a `.env` en esta carpeta (gitignoreado) y usar con
# `bun run --env-file .env dev` (o exportarlas a mano). Ver README.md.

# Bearer token que vos elegís — el server principal lo usa para
# autenticarse contra este gateway. Sin esto, TODO se rechaza con 500.
API_AI_PROVIDER_TOKEN=

# Uno de los dos, según qué expone GATEWAY_PROVIDER.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# anthropic-api (default) o claude-print — ver src/providers.ts.
GATEWAY_PROVIDER=anthropic-api

# Puerto en el que escucha este proceso.
PORT=3002

# ─── Self-registro (opcional) ──────────────────────────────────────────────
# Con las 3 seteadas, el gateway se da de alta solo contra uno o más
# servers apenas levanta — ver README.md, sección "Sola, al bootear".
# Dejar vacías para registrar a mano (curl) en su lugar.

# Uno o más baseUrl de servers ia-flow, separados por coma. Tiene que ser
# alcanzable DESDE donde corre este proceso. Ejemplo para
# runners/subscriptions-pipeline (publica su API en 127.0.0.1:3011, ver el
# docker-compose.yml de esa carpeta): http://localhost:3011
IA_FLOW_REGISTER_SERVER_URLS=

# El baseUrl por el que ESE server llega a este gateway (no necesariamente
# el mismo host:puerto en el que escucha PORT arriba). Si el server target
# corre en un container Podman, usá host.containers.internal (Docker
# Desktop en Mac: host.docker.internal) en vez de localhost — localhost
# dentro del container apunta al container mismo, no a tu host.
IA_FLOW_GATEWAY_PUBLIC_URL=http://localhost:3002

# El `name` de la registración.
IA_FLOW_PROVIDER_NAME=

# Reintentos por server si el POST falla (server todavía arrancando, típico
# en un docker-compose donde este gateway y el server suben a la vez).
# Defaults: 5 intentos, 2000ms entre uno y el siguiente.
IA_FLOW_REGISTER_RETRIES=5
IA_FLOW_REGISTER_RETRY_DELAY_MS=2000
