project:
  name: ia-flow
  language: español
agents:
  - id: backlog-tagger
    provider: anthropic-api
    save_output: false
    tools:
      - set_project_field
      - add_issue_labels
    prompt: |
      Eres un agente de clasificación de backlog de ingeniería. Analiza el issue y usa las herramientas disponibles para asignar sus campos y labels en el proyecto GitHub.

      Issue a clasificar:
      Title: {{task.title}}
      Description: {{task.description}}

      Contexto de todos los repos del proyecto (CLAUDE.md, estructura de archivos, manifests):
      {{context.repos}}

      Campos disponibles y sus opciones:
      - Task Type: {{project.field_options.task_type}}
      - Priority: {{project.field_options.priority}}
      - Size: {{project.field_options.size}}

      Reglas para Task Type:
      - functional: nueva funcionalidad visible para el usuario
      - technical: refactor, infra, deuda técnica
      - bug: comportamiento incorrecto
      - spike: investigación o prueba de concepto
      - hotfix: corrección urgente en producción

      Reglas para Priority:
      - Critical: bloquea usuarios o producción
      - High: impacto alto en negocio
      - Medium: mejora importante
      - Low: nice-to-have

      Reglas para Size:
      - XS: <2h, S: medio día, M: 1-2 días, L: 3-5 días, XL: +1 semana

      Labels disponibles (selecciona los que apliquen):
      backend, frontend, mobile, bug, enhancement, spike, hotfix, data-model, api, performance, security, chore, infra, database, auth, notifications, analytics

      Usa set_project_field para cada campo (Task Type, Priority, Size) y add_issue_labels para las etiquetas. No respondas con texto, solo llama las herramientas.
    variables:
      language: español
  - id: functional-refiner
    provider: anthropic-api
    prompt: |
      Refine this task into a Functional PRD. Follow the template exactly — no extra fields, no exceeding limits.

      Responde en {{variables.language}}.

      Task:
      Title: {{task.title}}
      Description: {{task.description}}
      Selected repos: {{task.repos}}

      Repo contexts:
      {{context.repos}}

      Rules:
      - This is a FUNCTIONAL PRD — describe WHAT and WHY, never HOW. No file paths, no endpoints, no DB schemas, no implementation details.
      - user_stories must describe user-visible behavior only. No technical steps, no API calls, no code references.
      - acceptance_criteria must be testable from a user's perspective — observable outcomes, not implementation checks.
      - impacted_repos: only name the repo and one sentence on business rationale. No file names, no technical specifics.
      - Identify ALL blocking open_questions upfront — do not defer any to future refinements.
      - Only add to open_questions what is strictly blocking — do not guess, do not assume.
      - Respect ALL limits in the template. Do not exceed them.

      Template (return ONLY this JSON, no markdown, no extra text):
      {
        "problem_statement": "1-2 sentences max.",
        "user_stories": [{"as_a":"","i_want":"","so_that":"","acceptance_criteria":[{"given":"","when":"","then":""}]}],
        "out_of_scope": ["string"],
        "open_questions": ["question?"],
        "impacted_repos": [{"repo":"","rationale":"","estimated_effort":"low|medium|high"}],
        "answered_questions": []
      }
    variables:
      language: español
  - id: technical-refiner
    provider: anthropic-api
    prompt: |
      Generate a Technical PRD for each listed repo. Follow the template exactly.

      Responde en {{variables.language}}.

      Task:
      Title: {{task.title}}
      Description: {{task.description}}
      Repos: {{task.repos}}

      Repo contexts:
      {{context.repos}}

      Rules:
      - All file paths must exist in the directory structure shown. Do not invent paths.
      - Test scenarios must be concrete BDD, not vague.
      - api_contract: omit entirely if no HTTP endpoint is added or changed.
      - data_model_changes: null if none.
      - Respect ALL limits in the template.

      Template (return ONLY this JSON, no markdown, no extra text):
      {
        "<repo_name>": {
          "repo": "repo-name",
          "files_to_modify": [{"path":"","change_type":"create|modify|delete","description":""}],
          "api_contract": {"endpoint":"","method":"","request_schema":{},"response_schema":{}},
          "data_model_changes": null,
          "test_scenarios": [{"scenario":"","given":"","when":"","then":""}],
          "dependencies": [{"repo":"","what":""}],
          "open_questions": [],
          "answered_questions": []
        }
      }
    variables:
      language: español
  - id: implementer
    provider: iterm-claude
    prompt: |
      Implement this GitHub issue: {{task.title}}

      Description:
      {{task.description}}

      Repos: {{task.repos}}

      Rules:
      1. Read the issue above — it has the full spec.
      2. Read CLAUDE.md before anything else and follow its conventions strictly.
      3. Use sub-agents and skills in .claude/ where appropriate.
      4. Run lint and tests before committing.
      5. Commit with a conventional commit message referencing the issue.
      6. Create a pull request when done.
statuses:
  - name: Backlog
    context:
      repos: all
    agents:
      - agent: backlog-tagger
        onProcess: Triaging
        onFinish: Queue
        onError: Backlog
  - name: queued
    context:
      repos: task
    agents:
      - agent: functional-refiner
        when:
          type: functional
        onProcess: refining
        onFinish: refined
        onError: queued
      - agent: technical-refiner
        when:
          type: technical
        onProcess: refining
        onFinish: refined
        onError: queued
  - name: approved
    context:
      repos: task
    agents:
      - agent: implementer
        onProcess: implementing
        onFinish: done
        onError: approved
  - name: Queue
    context:
      repos: task
    agents:
      - agent: functional-refiner
        when:
          Task Type: functional
        onProcess: Refining
        onFinish: Refined
        onError: Backlog
      - agent: technical-refiner
        when:
          Task Type: technical
        onProcess: Refining
        onFinish: Refined
        onError: Backlog
repos: {}
