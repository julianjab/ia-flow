# GitHub Projects
GITHUB_TOKEN=ghp_your_token_here
GITHUB_PROJECT_URL=https://github.com/orgs/la-haus/projects/42

# Claude auth — usa uno de los dos (OAuth tiene prioridad)
CLAUDE_CODE_OAUTH_TOKEN=    # token OAuth de Claude Code
ANTHROPIC_API_KEY=          # fallback: API key clásica

# Claude modelo (default: claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6

# System prompt inline (alternativa a config/system-prompt.md)
# CLAUDE_SYSTEM_PROMPT=You are...

# Slack (opcional — requerido para el proveedor de Slack Web API)
SLACK_BOT_TOKEN=            # xoxb-... con scopes channels:history, groups:history, im:history, mpim:history

# Server
PORT=3001

# OpenTelemetry (logs) — sink opcional; los sinks de siempre (daemon.log,
# pino-pretty, WS y IA_FLOW_REMOTE_LOG_URL) siguen funcionando igual.
# Las tres primeras son editables desde Configuración → Variables de entorno →
# Servidor; las cuatro últimas son identidad del deploy (sólo por env).
# Cualquier cambio toma efecto al reiniciar el proceso.

# Collector OTLP/HTTP. Vacío = sink apagado (default).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Headers extra para el backend, formato key1=value1,key2=value2.
# OTEL_EXPORTER_OTLP_HEADERS=
# Kill switch: en 'true' no se construye el sink aunque haya endpoint. Default: false.
# OTEL_SDK_DISABLED=false

# Nombre del servicio en el collector. Default: ia-flow-server.
# OTEL_SERVICE_NAME=ia-flow-server
# Resource attributes extra del deploy (k8s.pod.name, etc.), formato key=value,key=value.
# OTEL_RESOURCE_ATTRIBUTES=
# Va a deployment.environment.name. Default: development.
# OTEL_DEPLOYMENT_ENVIRONMENT=development
# Verbosidad del diag de OTel (errores del exporter). Default: sigue a LOG_LEVEL.
# OTEL_LOG_LEVEL=debug
