{
  "name": "@ia-flow/server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/entry/server.ts",
    "start": "bun run src/entry/server.ts",
    "prod": "LOG_SINGLE_LINE=true bun run src/entry/server.ts",
    "setup:github": "bun run ../../scripts/setup-github-project.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start:runner": "bun run src/entry/runner.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@ia-flow/agent-engine": "workspace:*",
    "@ia-flow/ai-providers": "workspace:*",
    "@ia-flow/figma-auth": "workspace:*",
    "@ia-flow/github-auth": "workspace:*",
    "@ia-flow/issue-sources": "workspace:*",
    "@ia-flow/rules": "workspace:*",
    "@ia-flow/shared": "workspace:*",
    "@ia-flow/slack": "workspace:*",
    "@ia-flow/tools": "workspace:*",
    "@ia-flow/workspace": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "chokidar": "^4.0.3",
    "hono": "^4.7.11",
    "ignore": "^7.0.6",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "yaml": "^2.7.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}
