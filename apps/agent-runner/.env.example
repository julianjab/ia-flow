# Copiar a `.env` en tu carpeta runners/<tu-instancia>/ (gitignoreada — ver
# README.md). Usalo desde docker-compose.yml de esa carpeta.

# webhook (default) o polling — ver apps/agent-runner/entrypoint.sh y
# apps/server/CLAUDE.md. polling no necesita túnel ni puerto publicado.
IA_FLOW_DAEMON_MODE=webhook

# Cosmético — solo aparece en el banner del secret del webhook al bootear.
IA_FLOW_RUNNER_REPO_LABEL=owner/repo

# Uno de los dos, según tu provider (ver agents.yaml — provider: anthropic-api
# usa cualquiera de los dos; buildAnthropicAuthHeader prioriza el token OAuth
# si están las dos seteadas).
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Necesita permisos de escritura sobre el repo que apuntes en tus YAML:
# contents, pull_requests, issues (según qué tools/MCP use tu roster).
GITHUB_TOKEN=ghp_...

# Opcional (solo modo webhook) — vacío = entrypoint.sh genera uno al primer
# boot y lo persiste en /data/webhook-secret (sobrevive a restarts).
IA_FLOW_WEBHOOK_SECRET=

# trace/debug/info/warn/error/fatal — vacío = info.
LOG_LEVEL=

# Log/execution forwarding opcional hacia el server principal del host
# (bun run dev:server, puerto 3001) — vacío = sin forward, esta instancia
# solo loguea a su propio /data. host.containers.internal (no
# host.docker.internal): Podman lo resuelve de fábrica, sin extra_hosts.
IA_FLOW_REMOTE_LOG_URL=http://host.containers.internal:3001/api/remote-logs
IA_FLOW_REMOTE_LOG_TOKEN=
IA_FLOW_REMOTE_EXECUTIONS_URL=http://host.containers.internal:3001/api/remote-executions
