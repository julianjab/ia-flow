      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showUnfilled": true
      },
      "id": 10
    },
    {
      "type": "bargauge",
      "title": "Costo por facturación y origen",
      "description": "`api`: se paga por token. `subscription`: sale de una suscripción (precio de lista, de referencia). `origin`: el runner o el host remoto.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sort_desc(sum by (billing, origin) (increase(ia_flow_llm_cost_usd_total{project=~\"$project\", agent=~\"$agent\", pipeline=~\"$pipeline\", model=~\"$model\"}[$__range])))",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "{{billing}} · {{origin}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "continuous-BlYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showUnfilled": true
      },
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Tokens por tipo",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (type) (increase(ia_flow_llm_tokens_total{project=~\"$project\", agent=~\"$agent\", pipeline=~\"$pipeline\", model=~\"$model\"}[$__interval]))",
          "instant": false,
          "range": true,
          "format": "time_series",
          "legendFormat": "{{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
