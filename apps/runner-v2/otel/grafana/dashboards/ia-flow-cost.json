    },
    {
      "type": "timeseries",
      "title": "Costo por request, por agente",
      "description": "Sube cuando crece el contexto de cada vuelta: la señal de un agente que lee de más.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (agent) (increase(ia_flow_llm_cost_usd_total{project=~\"$project\", agent=~\"$agent\", pipeline=~\"$pipeline\", model=~\"$model\"}[$__interval])) / sum by (agent) (increase(ia_flow_llm_requests_total{project=~\"$project\", agent=~\"$agent\", pipeline=~\"$pipeline\", model=~\"$model\"}[$__interval]))",
          "instant": false,
          "range": true,
          "format": "time_series",
          "legendFormat": "{{agent}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "stacking": {
              "mode": "none"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "Corridas de pipeline por estado",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "round(sum by (pipeline, status) (increase(ia_flow_pipeline_runs_total{project=~\"$project\", pipeline=~\"$pipeline\"}[$__interval])))",
          "instant": false,
          "range": true,
          "format": "time_series",
          "legendFormat": "{{pipeline}} · {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 14
    },
    {
      "type": "timeseries",
      "title": "Duración p95 por pipeline",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (pipeline, le) (increase(ia_flow_pipeline_duration_seconds_bucket{project=~\"$project\", pipeline=~\"$pipeline\"}[$__rate_interval])))",
          "instant": false,
          "range": true,
          "format": "time_series",
          "legendFormat": "{{pipeline}}"
        }
      ],
      "fieldConfig": {
