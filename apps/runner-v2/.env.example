# runner-v2 — las variables de entorno. Copiá esto a `.env` (gitignoreado) en esta carpeta:
# Bun lo carga solo al correr `bun run runner` / `bun run runner:serve`.
#
# La regla (ver .config/runner.yaml): secreto → acá; comportamiento → runner.yaml. El ambiente
# gana sobre runner.yaml en lo que ambos definen (puerto, identidad de GitHub).

# ── GitHub ────────────────────────────────────────────────────────────────────
# `auto` (default): la App si están los tres datos, si no GITHUB_TOKEN, si no `gh auth token`.
# appId e installationId ya vienen de runner.yaml (`github:`); acá sólo lo que es de la máquina.
# IA_FLOW_GITHUB_AUTH_MODE=auto                     # auto | github-app | static | gh-cli
# IA_FLOW_GITHUB_APP_ID=
# IA_FLOW_GITHUB_APP_INSTALLATION_ID=
# ruta absoluta al PEM de la App (nunca dentro del repo)
IA_FLOW_GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_TOKEN=                                    # PAT: modo `static`, o fallback de `auto` sin la App

# ── Servidor de webhooks (`--serve`) ──────────────────────────────────────────
# el secret del webhook de GitHub; sin él, 503
IA_FLOW_WEBHOOK_SECRET=
# IA_FLOW_SERVER_PORT=3001                         # default: settings.port de runner.yaml

# ── Modelos ───────────────────────────────────────────────────────────────────
# provider `anthropic-api` y la capacidad whenText (text-classifier)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5                  # pisa el modelo default de `anthropic-api`
# CLAUDE_CODE_OAUTH_TOKEN=                         # provider `claude-cli` (`claude setup-token`); sin él, la sesión del CLI usa tu login local

# ── Providers remotos (@ia-flow/provider-remote) ─────────────────────────────
# Del lado que despacha: cada `type: remote` de runner.yaml nombra su token (`token: ${VAR}`).
# IA_FLOW_REMOTE_GPU_BOX_TOKEN=                    # ej. el de `providers.gpu-box`
# Del lado que presta (`bun run host`):
# IA_FLOW_PROVIDER_HOST_TOKEN=                     # obligatorio: el bearer que esperan sus providers
# IA_FLOW_PROVIDER_HOST_PORT=3002                  # pisa `host.port`

# ── MCP (runner.yaml → mcp:) ──────────────────────────────────────────────────
# Un MCP sin su variable se omite con un aviso al arrancar; los agentes corren sin él.
# github-mcp usa el installation token de la App (no necesita variable).
# FIGMA_MCP_TOKEN=                                 # figma-mcp (Framelink self-hosted)
# MEMORY_MCP_URL=                                  # memory-mcp: https://<túnel>/mcp/<MEMORY_MCP_TOKEN>

# `bun run memory-mcp` (scripts/memory-mcp.sh), si levantás la memoria en local:
# MEMORY_MCP_TOKEN=                                # obligatorio: el path secreto del MCP
# MEMORY_MCP_PORT=8931
# MEMORY_FILE_PATH=.state/memory.json

# ── Slack ─────────────────────────────────────────────────────────────────────
# SLACK_BOT_TOKEN=xoxb-…                           # slack_* y request_slack_review; sin él fallan diciendo por qué
#                                                  # scopes: chat:write, channels:history, groups:history, users:read

# ── Workspace ─────────────────────────────────────────────────────────────────
# WORKSPACE_DIR=~/.cache/ia-flow/runner-v2/workspaces   # clones + worktrees de las tasks

# ── Telemetría (OpenTelemetry) ────────────────────────────────────────────────
# También se puede en runner.yaml (`settings.telemetry`); el ambiente gana.
# Sin endpoint no se exporta nada (la instrumentación queda en no-op).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=ai-development-flow-runner
# OTEL_DEPLOYMENT_ENVIRONMENT=local

# ── Otros ─────────────────────────────────────────────────────────────────────
# RUNNER_CONFIG_DIR=                               # otra carpeta de runner.yaml (default: .config)
