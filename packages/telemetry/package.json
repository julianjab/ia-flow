{
  "name": "@ia-flow/telemetry",
  "private": true,
  "version": "0.1.0",
  "description": "Trazas y logs para cualquier paquete de ia-tools — @traced/@tagged sobre métodos y un logger compuesto con sinks (consola, OpenTelemetry, los que arme la app). Sólo APIs de OpenTelemetry: sin SDK, no-op",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  }
}
