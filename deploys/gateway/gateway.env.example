# Copiar a `.env` en ESTA carpeta (gitignoreado — la regla ".env" de la raíz
# del repo cubre cualquier profundidad). Lo lee docker-compose.yml.

# OBLIGATORIO. El bearer que el gateway exige en cada request; el server que lo
# use tiene que mandar el MISMO valor. Sin esto todo responde 500.
API_AI_PROVIDER_TOKEN=algo-random-y-largo

# La credencial del modelo — con una alcanza.
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_CODE_OAUTH_TOKEN=

# Sólo si el provisioner de workspace está activo (clonar / pushear).
GITHUB_TOKEN=ghp_...

# Auto-registro al arrancar en frío. Con Podman, un server corriendo en tu host
# se alcanza por `host.containers.internal`. Lo que elijas después desde la
# pantalla del gateway gana sobre esto.
IA_FLOW_REGISTER_SERVER_URLS=http://host.containers.internal:3001
# Cómo ese server alcanza a ESTE gateway. Es la dirección vista DESDE EL
# SERVER, no desde el contenedor: `host.containers.internal` sólo resuelve
# adentro de un contenedor, así que ponerlo acá haría que el gateway se
# registre con una URL inalcanzable y todo dispatch remoto falle.
# El compose publica en 127.0.0.1:3002, así que para un server en tu host es
# localhost; para uno en otra máquina, la URL del túnel.
IA_FLOW_GATEWAY_PUBLIC_URL=http://localhost:3002

# Vacío = sin límite. Ponelo si la máquina tiene poca RAM.
GATEWAY_MAX_CONCURRENT_RUNS=
